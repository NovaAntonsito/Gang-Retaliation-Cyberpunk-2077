public class GRSpanish extends ModLocalizationPackage {
    protected func DefineTexts() -> Void {
        this.Text("GR-ModName", "Gang Retaliation");
        this.Text("GR-CatGeneral", "General");
        this.Text("GR-CatTriggers", "Creación de Némesis");
        this.Text("GR-CatToughness", "Dureza de los Némesis");
        this.Text("GR-SetHealthSoldier", "Vida de los Soldados");
        this.Text("GR-SetHealthLieutenant", "Vida de los Tenientes");
        this.Text("GR-SetHealthBoss", "Vida de los Jefes");
        this.Text("GR-SetHealthDesc", "Multiplicador de vida de los Némesis de este rango (1 = igual que un pandillero común). No afecta a la escolta. Se aplica la próxima vez que aparezcan.");
        this.Text("GR-SetLevelMatchV", "Nivel según V");
        this.Text("GR-SetLevelMatchVDesc", "NO: los Némesis tienen el nivel del distrito, como cualquier pandillero (por defecto). SÍ: tienen el nivel de V, más el extra por rango de abajo.");
        this.Text("GR-SetLevelPerRank", "Niveles extra por rango");
        this.Text("GR-SetLevelPerRankDesc", "Solo con \"Nivel según V\". Los Tenientes quedan esto por encima de V y los Jefes el doble. Los Soldados quedan al nivel de V.");
        this.Text("GR-CatDebug", "Depuración");

        this.Text("GR-SetEnabled", "Activar mod");
        this.Text("GR-SetEnabledDesc", "Activa o desactiva el sistema Némesis. Los datos guardados se conservan.");
        this.Text("GR-SetMaxPerGang", "Máximo de Némesis por banda");
        this.Text("GR-SetMaxPerGangDesc", "Cuántos enemigos con nombre puede tener la jerarquía de cada banda.");
        this.Text("GR-SetIntelDropChance", "Probabilidad de shard de intel (%)");
        this.Text("GR-SetIntelDropChanceDesc", "Probabilidad de que un shard de intel caiga de un miembro de banda comun derribado, muerto o inconsciente. Los Némesis con nombre siempre lo dejan.");
        this.Text("GR-SetBossBar", "Barra de jefe de los Némesis");
        this.Text("GR-SetBossBarDesc", "Muestra la barra de vida de jefe con el nombre del Némesis cuando aparece o le pegas. La escolta no la tiene.");
        this.Text("GR-SetStrongholdBanner", "Banner de las guaridas en el mapa");
        this.Text("GR-SetStrongholdBannerDesc", "Muestra la imagen de la pandilla al final del tooltip de la guarida en el mapa del mundo.");
        this.Text("GR-SetNotifyCenter", "Avisos en el centro de la pantalla");
        this.Text("GR-SetNotifyCenterDesc", "SÍ: las novedades de los Némesis salen como aviso grande en el centro. NO: van discretas al registro lateral (como los objetos saqueados). En los dos casos esperan a que terminen las escenas, las danzas cerebrales y los menús.");
        this.Text("GR-SetEscapeHealth", "Vida para huida herida (%)");
        this.Text("GR-SetEscapeHealthDesc", "Un pandillero que sale del combate con esta vida o menos se convierte en Némesis.");
        this.Text("GR-SetKnockoutChance", "Probabilidad de ascenso por derribo (%)");
        this.Text("GR-SetKnockoutChanceDesc", "Probabilidad de que un pandillero que dejas inconsciente (mientras te tenía detectado) se convierta en Némesis. Las huidas y escapes heridos siempre cuentan.");
        this.Text("GR-SetDebugLog", "Log de depuración");
        this.Text("GR-SetDebugLogDesc", "Escribe mensajes detallados en el log de redscript y en la consola de CET.");
        this.Text("GR-SetDebugOnScreen", "Log de depuración en pantalla");
        this.Text("GR-SetDebugOnScreenDesc", "Muestra mensajes de depuración en un panel desplazable mientras juegas, sin esperar a que se vuelque gamelog.log. Es independiente del log de depuración de arriba: activa cualquiera de los dos, ambos, o ninguno. Usa las tres casillas de abajo para elegir que categorias se muestran.");
        this.Text("GR-SetDebugOnScreenDetection", "En pantalla: Deteccion y huida");
        this.Text("GR-SetDebugOnScreenDetectionDesc", "Mensajes de combate, huida, escondite, desaparicion y desarme. Solo se muestra si el log de depuración en pantalla de arriba tambien esta activo.");
        this.Text("GR-SetDebugOnScreenSpawner", "En pantalla: Aparicion y desaparicion");
        this.Text("GR-SetDebugOnScreenSpawnerDesc", "Mensajes de limpieza de cadaveres/sobras de spawns propios (p. ej. el tiempo de eliminacion de cadaveres). Solo se muestra si el log de depuración en pantalla de arriba tambien esta activo.");
        this.Text("GR-SetDebugOnScreenCampaign", "En pantalla: Campaña y recompensas");
        this.Text("GR-SetDebugOnScreenCampaignDesc", "Todo lo demas del lado de Lua: ascensos de Némesis, nuevo look cromado, armas de jefe, redadas, emboscadas, gigs, rasgos. Solo se muestra si el log de depuración en pantalla de arriba tambien esta activo.");
        this.Text("GR-SetDebugOnScreenStronghold", "En pantalla: Guaridas");
        this.Text("GR-SetDebugOnScreenStrongholdDesc", "Mensajes de colocacion/escaneo de guaridas (eleccion de ubicacion, mudanzas, revalidacion). Estos siempre se escriben en gamelog.log sin importar el log de depuración - esto solo controla si tambien se muestran en pantalla.");
        this.Text("GR-CatAbout", "Acerca de");
        this.Text("GR-SetVersion", "Gang Retaliation v1.5.5");
        this.Text("GR-SetVersionDesc", "Solo informativo. Activarlo o desactivarlo no hace nada.");
        this.Text("GR-CatHud", "HUD");
        this.Text("GR-SetNameplateScale", "Tamaño de la barra de vida enemiga");
        this.Text("GR-SetNameplateScaleDesc", "Escala la barra de vida del enemigo que miras. 1.0 = como en el juego.");
        this.Text("GR-SetFleeMark", "Línea de huida en las barras");
        this.Text("GR-SetFleeMarkDesc", "Una línea amarilla marca con cuánta vida huye este pandillero si queda último en pie. Solo aparece si de verdad puede huir.");
        this.Text("GR-SetThreatPanel", "Panel de amenazas");
        this.Text("GR-SetThreatPanelDesc", "En combate, lista a los enemigos que te tienen como objetivo, cada uno con una barra de vida pequeña.");
        this.Text("GR-SetThreatX", "Panel de amenazas: X");
        this.Text("GR-SetThreatXDesc", "Posición horizontal en unidades 4K (se escala a tu resolución).");
        this.Text("GR-SetThreatY", "Panel de amenazas: Y");
        this.Text("GR-SetThreatYDesc", "Posición vertical en unidades 4K (se escala a tu resolución).");
        this.Text("GR-SetThreatScale", "Tamaño del panel de amenazas");
        this.Text("GR-SetThreatScaleDesc", "Escala todo el panel: textos, barras y recuadro.");
        this.Text("GR-SetThreatOpacity", "Fondo del panel de amenazas");
        this.Text("GR-SetThreatOpacityDesc", "Opacidad del fondo del recuadro. 0 = sin fondo.");
        this.Text("GR-SetThreatRows", "Filas del panel de amenazas");
        this.Text("GR-SetThreatRowsDesc", "Cuántos enemigos se listan. El resto aparece como \"+N más\".");
        this.Text("GR-HudThreats", "AMENAZAS");
        this.Text("GR-HudMore", "+%d más");
        this.Text("GR-HudNemesis", "NEMESIS");

        this.Text("GR-UiCampaign", "Campaña");
        this.Text("GR-UiHomes", "Refugios (sin emboscadas cerca)");
        this.Text("GR-UiRemoveHome", "Quitar el refugio más cercano");
        this.Text("GR-UiNemeses", "Némesis");
